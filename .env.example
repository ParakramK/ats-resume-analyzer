# Optional developer overrides. The app does NOT read API keys from env/files.
# API keys are entered in the sidebar at runtime, kept only in session memory,
# and are never persisted anywhere by this application.

# HTTP client behavior (seconds / bytes / retry count on transient failures)
ATS_HTTP_TIMEOUT=30
ATS_HTTP_MAX_RESPONSE_BYTES=2000000
ATS_HTTP_MAX_RETRIES=2

# Logging (metadata only — never API keys, document text, or AI replies)
# ATS_LOG_LEVEL=INFO
# ATS_LOG_FILE=./ats_analyzer.log   # optional rotating debug log (3 x 1 MB)
